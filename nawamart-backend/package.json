{
  "name": "nawamart-backend",
  "version": "1.0.0",
  "description": "NawaMart API — Yemeni SaaS e-commerce platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node test-proration.js",
    "test:integration": "node test-subscription-limits.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "audit": "npm audit --audit-level=high",
    "security:check": "npm run check && npm audit --audit-level=high",
    "outdated": "npm outdated",
    "backup:create": "node scripts/backup-create.js",
    "backup:restore": "node scripts/backup-restore.js",
    "backup:list": "node scripts/backup-list.js"
  },
  "keywords": [
    "nawamart",
    "ecommerce",
    "saas",
    "yemen"
  ],
  "author": "NawaMart Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.10",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "validator": "^13.12.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
