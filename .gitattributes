# Set default behavior for all files
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denoting files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
